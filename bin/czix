#!/usr/bin/env python3
"""Run czix straight from a checkout: ./bin/czix ..."""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "src"))

from czix.cli import main  # noqa: E402  (sys.path fiddling first)

if __name__ == "__main__":
    sys.exit(main())
